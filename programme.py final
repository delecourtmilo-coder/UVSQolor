def noir_et_blanc():
    global image, matrice_image

    if matrice_image is not None:
        
        sauvegarder_avant_filtre()

        rouge = matrice_image[:, :, 0]
        vert = matrice_image[:, :, 1]
        bleu = matrice_image[:, :, 2]

        gris = (rouge + vert + bleu) / 3

        resultat = np.zeros(matrice_image.shape)
        resultat[:, :, 0] = gris
        resultat[:, :, 1] = gris
        resultat[:, :, 2] = gris

        matrice_image = np.clip(resultat, 0, 255).astype("uint8")

        image = Image.fromarray(matrice_image)
        afficher_image()


menu_filtres.add_command(label="Noir et blanc", command=noir_et_blanc)





#Fonction pour annuler le dernier filtre appliqué

def sauvegarder_avant_filtre(): #Ici on copie la matrice avant le changement
    global matrice_avant_filtre, matrice_image

    if matrice_image is not None:
        matrice_avant_filtre = matrice_image.copy()

def annuler(): #ici on revient en arrière grâce à la sauvegarde
#On ne peut revenir en arrière qu'une seule fois
    global image, matrice_image, matrice_avant_filtre

    if matrice_avant_filtre is not None:
        matrice_image = matrice_avant_filtre.copy() #On rajoute copy pour plus de sécurité, on nee voudrait pas que ça pointe vers la meme liste
        image = Image.fromarray(matrice_image.astype("uint8"))
        afficher_image()

menu_filtres.add_command(label="Annuler", command=annuler)


