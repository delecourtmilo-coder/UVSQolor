historique = []
indice_historique = -1
menu_edition = None

#Afficher l'image (fonction réutilisée dans ouvrir image après)

def afficher_image():
    global photo, image, canvas
    

    photo = ImageTk.PhotoImage(image) 
    #parce que l'image est en format PIL qui est non affichable. 
    #On met photo en format Tkinter

    canvas.config(width=image.width, height=image.height)
    canvas.delete("all")
     # On efface ce qu'il y avait avant pour que les images ne s'empilent pas les unes sur les autres 
     # "all" est compris par le programme comme pour "blue"
    canvas.create_image(0, 0,anchor=tk.NW, image=photo) #On a rajouté Anchor parce que sinon l'image est coupée et mal placée

#Ouvrir une image 

def ouvrir_image():
    global image, photo, matrice_image
    
    nom_fichier = filedialog.askopenfilename(title="Choisis ton image",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.bmp")])
    
    if nom_fichier != "":
        image = Image.open(nom_fichier).convert("RGB")
        matrice_image = np.array(image)

        afficher_image()

        print("Image ouverte :", nom_fichier)
        print("Taille de l'image :", image.size)
        print("Forme de la matrice :", matrice_image.shape)

