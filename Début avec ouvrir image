#Import de toutes les choses nécessaires

import numpy as np
import tkinter as tk
from tkinter import filedialog
from PIL import Image, ImageTk

#Initialisation des fonctions qu'on utilisera 

image = None
photo = None
matrice_image = None


#Afficher l'image (fonction réutilisée dans ouvrir image après)

def afficher_image():
    global photo, image, canvas

    photo = ImageTk.PhotoImage(image)

    canvas.config(width=image.width, height=image.height)
    canvas.delete("all")
    canvas.create_image(0, 0, anchor=tk.NW, image=photo)


#Ouvrir une image 

def ouvrir_image():
    global image, photo, matrice_image
    
    nom_fichier = filedialog.askopenfilename(title="Choisis ton image",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.bmp")])
    
    if nom_fichier != "":
        image = Image.open(nom_fichier).convert("RGB")
        matrice_image = np.array(image)

        afficher_image()

        print("Image ouverte :", nom_fichier)
        print("Taille de l'image :", image.size)
        print("Forme de la matrice :", matrice_image.shape)

# Création de la fenêtre pour l'utilisateur

fenetre = tk.Tk()
fenetre.title("UVSQolor")
fenetre.geometry("800x600")

canvas = tk.Canvas(fenetre, bg="white")
canvas.pack() #on utilise pack pour l'instant parce que c'est plus simple mais on va peut etre utilisé grid() par la suite 

# Menu
menu = tk.Menu(fenetre)
fenetre.config(menu=menu) #propriété menu=l'objet qu'on a défini nommé menu

menu_fichier = tk.Menu(menu, tearoff=0) #Quand on clique sur menu, le sous menu fichier apparaitra. tearoff permet de rendre ce sous menu non détachable
menu.add_cascade(label="Fichier", menu=menu_fichier)# add_cascade est la pour ajouter un menu déroulant dans la bare principale

menu_fichier.add_command(label="Ouvrir", command=ouvrir_image)

# Boucle principale
fenetre.mainloop()
