#Initialisation des fonctions qu'on utilisera 

image = None
photo = None
matrice_image = None

#Afficher l'image (fonction réutilisée dans ouvrir image après)

def afficher_image():
    global photo, image, canvas

    photo = ImageTk.PhotoImage(image) 
    #parce que l'image est en format PIL qui est non affichable. 
    #On met photo en format Tkinter

    canvas.config(width=image.width, height=image.height)
    canvas.delete("all")
     # On efface ce qu'il y avait avant pour que les images ne s'empilent pas les unes sur les autres 
     # "all" est compris par le programme comme pour "blue"
    canvas.create_image(0, 0,anchor=tk.NW, image=photo) #On a rajouté Anchor parce que sinon l'image est coupée et mal placée

#Ouvrir une image 

def ouvrir_image():
    global image, photo, matrice_image
    
    nom_fichier = filedialog.askopenfilename(title="Choisis ton image",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.bmp")])
    
    if nom_fichier != "":
        image = Image.open(nom_fichier).convert("RGB")
        matrice_image = np.array(image)

        afficher_image()

        print("Image ouverte :", nom_fichier)
        print("Taille de l'image :", image.size)
        print("Forme de la matrice :", matrice_image.shape)

# Création de la fenêtre pour l'utilisateur

fenetre = tk.Tk()
fenetre.title("UVSQolor")
fenetre.geometry("800x600")

canvas = tk.Canvas(fenetre, bg="white")
canvas.grid(row=1, column=0) #on utilise pack() pour l'instant parce que c'est plus simple mais on va peut etre utilisé grid() par la suite 


# Menu
menu = tk.Menu(fenetre)
fenetre.config(menu=menu) #propriété menu=l'objet qu'on a défini nommé menu

menu_fichier = tk.Menu(menu, tearoff=0) #Quand on clique sur menu, le sous menu fichier apparaitra. tearoff permet de rendre ce sous menu non détachable
menu.add_cascade(label="Fichier", menu=menu_fichier)# add_cascade est la pour ajouter un menu déroulant dans la bare principale

menu_fichier.add_command(label="Ouvrir", command=ouvrir_image)



#Filtre négatif

def negatif():
    global image, matrice_image

    if matrice_image is not None: #Donc si l'utilisateur a bien mis une image 
        matrice_image = 255 - matrice_image # On inverse les couleurs
        image = Image.fromarray(matrice_image)#image = Image.fromarray(matrice_image.astype("uint8")) # on peut garder image = Image.fromarray(matrice_image) mais avec astype("uint8")est plus sur pour le code
        #astype("uint8") force le code à rester entre 0 et 255
        afficher_image()

menu_fichier.add_command(label="Négatif", command=negatif)


def luminosite():
    global image, matrice_image

    if matrice_image is not None:
        matrice_image = matrice_image + 40 #ça augmente la luminosité de 40
        matrice_image = np.clip(matrice_image, 0, 255) #on fait en sorte que ça ne sorte pas de l'intervalle 0-255
        image = Image.fromarray(matrice_image) #On peut aussi utiliser image = Image.fromarray(matrice_image.astype("uint8"))
        afficher_image()

menu_fichier.add_command(label="Luminosité", command=luminosite)


















#Mainloop
fenetre.mainloop()
