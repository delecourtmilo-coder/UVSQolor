#Filtre négatif

def negatif():
    global image, matrice_image

    if matrice_image is not None: #Donc si l'utilisateur a bien mis une image 
        matrice_image = 255 - matrice_image # On inverse les couleurs
        image = Image.fromarray(matrice_image)#image = Image.fromarray(matrice_image.astype("uint8")) # on peut garder image = Image.fromarray(matrice_image) mais avec astype("uint8")est plus sur pour le code
        #astype("uint8") force le code à rester entre 0 et 255
        afficher_image()

menu_fichier.add_command(label="Négatif", command=negatif)


def luminosite():
    global image, matrice_image

    if matrice_image is not None:
        matrice_image = matrice_image + 40 #ça augmente la luminosité de 40
        matrice_image = np.clip(matrice_image, 0, 255) #on fait en sorte que ça ne sorte pas de l'intervalle 0-255
        image = Image.fromarray(matrice_image) #On peut aussi utiliser image = Image.fromarray(matrice_image.astype("uint8"))
        afficher_image()

menu_fichier.add_command(label="Luminosité", command=luminosite)


















